<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TunerFish.Views.AboutWindow"
        Icon="avares://TunerFish/Assets/icon/tunerfish-256.png"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- Theme colours only (no hard-coded brushes), so it follows light and dark. Texts are set in code. -->
  <StackPanel Margin="24,20,24,18" Spacing="6">
    <Image Source="avares://TunerFish/Assets/logo/tunerfish-logo-512.png"
           Width="192" Height="192" HorizontalAlignment="Center"
           RenderOptions.BitmapInterpolationMode="HighQuality" />
    <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <TextBlock x:Name="VersionText" Opacity="0.7" HorizontalAlignment="Center" />
    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
    <TextBlock x:Name="CreditText" TextWrapping="Wrap" TextAlignment="Center" />
    <TextBlock x:Name="CopyrightText" TextWrapping="Wrap" TextAlignment="Center" />
    <TextBlock x:Name="CreditsText" TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Opacity="0.7" />
    <Button x:Name="CloseButton" Content="Close" IsDefault="True" IsCancel="True"
            HorizontalAlignment="Center" MinWidth="96" HorizontalContentAlignment="Center" Margin="0,12,0,0" />
  </StackPanel>
</Window>
